{
	"name": "twentig-one",
	"private": true,
	"version": "1.0.1",
	"description": "A modern block theme for WordPress.",
	"author": "Twentig",
	"license": "GPL-3.0-or-later",
	"keywords": [
		"WordPress",
		"Theme",
		"Block Theme"
	],
	"homepage": "https://twentig.com/twentig-one",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/twentig/twentig-one.git"
	},
	"bugs": {
		"url": "https://github.com/twentig/twentig-one/issues"
	},
	"engines": {
		"node": ">=20.10.0",
		"npm": ">=10.2.3"
	},
	"scripts": {
		"build": "npm run build:css && npm run build:js",
		"clean": "rimraf --glob style.min.css \"assets/css/**/*.min.css\" \"assets/js/**/*.min.js\"",
		"prebuild:css": "npm run clean",
		"build:css": "postcss style.css -o style.min.css --no-map && postcss assets/css/*.css -d assets/css/ --ext min.css --no-map && postcss assets/css/blocks/*.css -d assets/css/blocks/ --ext min.css --no-map",
		"build:js": "terser assets/js/theme.js -o assets/js/theme.min.js --compress --mangle",
		"lint:css": "stylelint \"**/*.css\" --ignore-path .gitignore --ignore-pattern \"**/*.min.css\" --ignore-pattern \"plugin-update-checker/**\"",
		"lint:css:fix": "stylelint \"**/*.css\" --ignore-path .gitignore --ignore-pattern \"**/*.min.css\" --ignore-pattern \"plugin-update-checker/**\" --fix"
	},
	"devDependencies": {
		"@wordpress/browserslist-config": "^6.34.0",
		"@wordpress/stylelint-config": "^23.30.0",
		"cssnano": "^7.1.2",
		"postcss": "^8.5.6",
		"postcss-cli": "^11.0.1",
		"rimraf": "^5.0.5",
		"stylelint": "^16.11.0",
		"terser": "^5.46.0"
	},
	"browserslist": [
		"extends @wordpress/browserslist-config"
	]
}
